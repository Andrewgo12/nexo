# Set a same-origin API path (for example /api) or an absolute Laravel API URL.
# Leave at /api to use Vite's development proxy or same-origin deployment routing.
VITE_API_URL=/api
# Vite development proxy destination; used only by npm run dev.
API_PROXY_TARGET=http://127.0.0.1:8000

# Leave blank to use the public demonstration services (availability and usage policies apply).
VITE_OSRM_DRIVING_URL=
VITE_OSRM_FOOT_URL=
VITE_OSRM_BIKE_URL=
VITE_NOMINATIM_URL=
VITE_MIO_GTFS_FEATURE_SERVICE=

# Optional local OSRM container; set this to match the .osm.pbf filename in ops/osrm/data.
OSRM_DATASET_NAME=colombia-latest
